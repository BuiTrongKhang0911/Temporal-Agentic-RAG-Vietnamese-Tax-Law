# Required for production, corpus construction, and Gemini experiments.
GOOGLE_API_KEY=your_google_api_key_here

# Gemini models used by the end-to-end experiments and production workflow.
E2E_BASELINE_GEMINI_MODEL=models/gemini-3.1-flash-lite
E2E_PROPOSED_GEMINI_MODEL=models/gemini-3.1-flash-lite
E2E_JUDGE_GEMINI_MODEL=models/gemini-3.5-flash-lite

# Gemini models used by offline corpus construction.
CORPUS_ANALYSIS_GEMINI_MODEL=models/gemini-3.1-flash-lite
SAC_TIER1_GEMINI_MODEL=models/gemini-3.1-flash-lite
SAC_TIER2_GEMINI_MODEL=models/gemini-3.1-flash-lite

# Experiment runners only; the interactive production backend ignores it.
E2E_LLM_CALL_DELAY_SECONDS=5

# Optional: shared Qwen 3.5 27B profile for the reported Qwen experiment.
# Run Qwen with Ollama on an external GPU platform and expose its API through
# ngrok. Set QWEN_OLLAMA_TOKEN only when the proxy requires Bearer auth.
QWEN_OLLAMA_URL=https://your-ngrok-domain.ngrok-free.app
QWEN_OLLAMA_TOKEN=
QWEN_MODEL=qwen3.5:27b-q4_K_M
QWEN_NUM_CTX=32768
QWEN_TIMEOUT=600
QWEN_MAX_OUTPUT=2048
QWEN_FACT_MAX_OUTPUT=4096
QWEN_KEEP_ALIVE=30m
QWEN_CLARIFIER_PYTHON_GUARDS=false
